# Compose only; use random hexadecimal values, never the example placeholders.
POSTGRES_DB=student_planner
POSTGRES_USER=studplan
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Initial IP check: :80. After DNS setup: your actual domain (without https://).
SITE_ADDRESS=:80
CLIENT_ORIGIN=http://localhost
HTTP_PORT=80
HTTPS_PORT=443
