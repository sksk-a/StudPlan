{
  "name": "student-planner",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "db:generate": "npm run db:generate --workspace server",
    "db:validate": "npm run db:validate --workspace server",
    "db:studio": "npm run db:studio --workspace server",
    "db:migrate": "npm exec --workspace server -- prisma migrate dev",
    "seed": "npm run seed --workspace server",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "test": "npm test --workspace server",
    "test:e2e": "playwright test"
  },
  "overrides": {
    "effect": "^3.20.0",
    "deepmerge-ts": "^8.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "prettier": "^3.9.8"
  }
}
